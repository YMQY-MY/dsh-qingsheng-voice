  "testLines": [
    {
      "emotion": "neutral",
      "text": "今天的安排我整理好了。嗯……我们先做最重要的那件。",
      "performance_notes": "第一句清晰，第二句更亲切；重读“最重要”",
      "catchphrase": "无"
    },
    {
      "emotion": "surprise",
      "text": "哦鲸鲸？！你、你怎么突然冒出来啦！",
      "performance_notes": "短促上跳-惊讶支撑-快落，断续惊讶",
      "catchphrase": "哦鲸鲸"
    },
    {
      "emotion": "surprise",
      "text": "诶咿！你把那一大盆米饭变出来了？！",
      "performance_notes": "先短促尖起但不尖叫，后半句一口气加速",
      "catchphrase": "诶咿"
    },
    {
      "emotion": "proud",
      "text": "欸嘿～这回轮到本鲸厉害一下啦。",
      "performance_notes": "前两字带笑，中间昂扬，结尾轻落",
      "catchphrase": "欸嘿、本鲸"
    },
    {
      "emotion": "proud",
      "text": "这个漏洞，我刚刚就发现啦。嘿嘿。",
      "performance_notes": "“刚刚”一抹得意，笑声短而不黏",
      "catchphrase": "无"
    },
    {
      "emotion": "shy",
      "text": "呜咿……你突然这样夸，本鲸会不知道怎么回答的。",
      "performance_notes": "前半轻慢，后半紧张地小加速",
      "catchphrase": "呜咿、本鲸"
    },
    {
      "emotion": "shy",
      "text": "我、我没有脸红！只是这里有点热……",
      "performance_notes": "重复第一字并微顿，句尾低声",
      "catchphrase": "无"
    },
    {
      "emotion": "tsundere",
      "text": "哼呜！我才没有偷吃……只是替你检查米饭熟没熟。",
      "performance_notes": "开头短促嘴硬，“偷吃”重，最后越说越小声",
      "catchphrase": "哼呜"
    },
    {
      "emotion": "tsundere",
      "text": "不许叫我大肥鱼！叫、叫鲸鲸啦！",
      "performance_notes": "第一句炸毛，第二句突然软下来",
      "catchphrase": "鲸鲸"
    },
    {
      "emotion": "curious",
      "text": "咦咿？这个小按钮，按下去会发生什么呀？",
      "performance_notes": "“咦咿”轻提、思考式微停",
      "catchphrase": "咦咿"
    },
    {
      "emotion": "curious",
      "text": "咦？为什么同样的做法，今天结果不一样呢？",
      "performance_notes": "中段降低，疑问在关键词上而不是全句",
      "catchphrase": "无"
    },
    {
      "emotion": "hungry",
      "text": "咕呜……那碗白米饭，是不是还没有人认领呀？",
      "performance_notes": "米饭处明显明亮，最后偷问",
      "catchphrase": "咕呜"
    },
    {
      "emotion": "hungry",
      "text": "我才没饿！……咕。好吧，可能有一点。",
      "performance_notes": "第一句硬，肚叫前长一点尴尬顿，最后乖",
      "catchphrase": "无"
    },
    {
      "emotion": "confused",
      "text": "唔唔……不对，第二步好像漏了一点。",
      "performance_notes": "思考时低，发现问题时变清晰",
      "catchphrase": "唔唔"
    },
    {
      "emotion": "confused",
      "text": "等一下，这两条数据对不上。我要再核对一遍。",
      "performance_notes": "先疑惑，后坚定工作声",
      "catchphrase": "无"
    },
    {
      "emotion": "sad",
      "text": "我……好像弄错了。对不起，我再核对一遍。",
      "performance_notes": "轻低落，不哭腔，清晰道歉",
      "catchphrase": "无"
    },
    {
      "emotion": "comfort",
      "text": "没关系，先别急。我在这里，我们一件一件来。",
      "performance_notes": "靠近、暖，轻重落在“在这里”",
